    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Blackbox probes, systemd units, inbound replication, kernel clock sync and LDAPS certificate validity per DC.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "center",
            "cellOptions": {
              "mode": "basic",
              "type": "color-background"
            },
            "inspect": false,
            "minWidth": 50
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "FAIL"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "OK"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "DC"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "LDAPS cert"
            },
            "properties": [
              {
                "id": "mappings",
                "value": []
              },
              {
                "id": "unit",
                "value": "suffix: d"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 14
                    },
                    {
                      "color": "green",
                      "value": 30
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (dc, check) (\n  label_replace(label_replace(probe_success{job=\"blackbox\", name=~\"dc-($dc)-(dns|ldap|ldaps|kerberos|gc|smb)\"}, \"dc\", \"$1\", \"name\", \"dc-(.+)-(?:dns|ldap|ldaps|kerberos|gc|smb)\"), \"check\", \"$1\", \"name\", \"dc-.+-(dns|ldap|ldaps|kerberos|gc|smb)\")\n  or label_replace(label_replace(node_systemd_unit_state{job=\"integrations/unix\", instance=~\"$dc\", name=~\"(samba-ad-dc|named)[.]service\", state=\"active\"}, \"dc\", \"$1\", \"instance\", \"(.+)\"), \"check\", \"$1\", \"name\", \"(.+)[.]service\")\n  or label_replace(label_replace(min by (instance) (samba_drs_up{instance=~\"$dc\"}) * on (instance) (max by (instance) (samba_drs_consecutive_failures{instance=~\"$dc\", direction=\"inbound\"}) == bool 0), \"dc\", \"$1\", \"instance\", \"(.+)\"), \"check\", \"replication\", \"\", \"\")\n  or label_replace(label_replace(node_timex_sync_status{instance=~\"$dc\"}, \"dc\", \"$1\", \"instance\", \"(.+)\"), \"check\", \"time\", \"\", \"\")\n  or label_replace(label_replace((probe_ssl_earliest_cert_expiry{job=\"blackbox\", name=~\"dc-($dc)-ldaps\"} - time()) / 86400, \"dc\", \"$1\", \"name\", \"dc-(.+)-ldaps\"), \"check\", \"cert\", \"\", \"\")\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Health",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "check",
            "emptyValue": "null",
            "rowField": "dc",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "cert": 11,
              "dc\\check": 0,
              "dns": 1,
              "gc": 4,
              "kerberos": 5,
              "ldap": 2,
              "ldaps": 3,
              "named": 8,
              "replication": 9,
              "samba-ad-dc": 7,
              "smb": 6,
              "time": 10
            },
            "renameByName": {
              "cert": "LDAPS cert",
              "dc\\check": "DC",
              "time": "time sync"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
