{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    ":automergeBranch",
    ":disableRateLimiting",
    ":semanticCommits",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "schedule": [
    "every weekend"
  ],
  "ignorePaths": [
    "**/*.sops.*"
  ],
  "flux": {
    "managerFilePatterns": [
      "/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"
    ]
  },
  "helmfile": {
    "managerFilePatterns": [
      "/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
      "/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/^kustomization\\.ya?ml(?:\\.j2)?$/"
    ]
  },
  "packageRules": [
    {
      "description": "Override Helmfile Dependency Name",
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "helmfile"
      ],
      "overrideDepName": "{{packageName}}"
    },
    {
      "description": "Flux Operator Group",
      "groupName": "flux-operator",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/flux-operator/",
        "/flux-instance/",
        "/flux-operator-manifests/"
      ],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 3
    },
    {
      "description": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "minimumReleaseAge": "3 days",
      "ignoreTests": true
    },
    {
      "description": "Auto-merge Mise Tools",
      "matchManagers": [
        "mise"
      ],
      "automerge": true,
      "automergeType": "branch",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "ignoreTests": true
    },
    {
      "description": "Auto-merge *arr apps patch updates",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/home-operations/radarr",
        "ghcr.io/home-operations/sonarr",
        "ghcr.io/home-operations/prowlarr"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "rebase",
      "platformAutomerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "semanticCommitType": "feat",
      "commitMessagePrefix": "{{semanticCommitType}}({{semanticCommitScope}})!:",
      "commitMessageExtra": "( {{currentVersion}} ➔ {{newVersion}} )"
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "semanticCommitType": "feat",
      "commitMessageExtra": "( {{currentVersion}} ➔ {{newVersion}} )"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "semanticCommitType": "fix",
      "commitMessageExtra": "( {{currentVersion}} ➔ {{newVersion}} )"
    },
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "semanticCommitType": "chore",
      "commitMessageExtra": "( {{currentDigestShort}} ➔ {{newDigestShort}} )"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "semanticCommitScope": "container",
      "commitMessageTopic": "image {{depName}}",
      "labels": [
        "renovate/container"
      ]
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "semanticCommitScope": "helm",
      "commitMessageTopic": "chart {{depName}}",
      "labels": [
        "renovate/helm"
      ]
    },
    {
      // Flux uses the docker datasource for OCI charts, without a chart depType.
      // Match chart repository paths, not managers/files: both also contain images.
      // labels replaces the container label; update-type labels remain additive.
      "description": "OCI Helm charts",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/(?:^|/)(?:charts|charts-mirror|helm-charts|helm)\//"
      ],
      "semanticCommitScope": "helm",
      "commitMessageTopic": "chart {{depName}}",
      "labels": [
        "renovate/helm"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "github-action",
      "commitMessageTopic": "action {{depName}}"
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "semanticCommitScope": "github-release",
      "commitMessageTopic": "release {{depName}}"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "semanticCommitScope": "mise",
      "commitMessageTopic": "tool {{depName}}"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "type/major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "type/minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "type/patch"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "renovate/github-action"
      ]
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "addLabels": [
        "renovate/github-release"
      ]
    },
    {
      "matchDatasources": [
        "custom.talos-factory"
      ],
      "description": "Offer Talos updates per minor stream for sequential upgrades",
      "matchPackageNames": [
        "siderolabs/talos"
      ],
      "versioning": "semver",
      "semanticCommitScope": "talos",
      // Canonicalize the CLI's bare version to the cluster's v-prefixed form.
      // Renovate otherwise drops differing version suffixes from the shared PR title.
      "commitMessageExtra": "( v{{{replace '^v' '' currentVersion}}} ➔ v{{{replace '^v' '' newVersion}}} )",
      // Factory determines availability; GitHub supplies release notes.
      "sourceUrl": "https://github.com/siderolabs/talos",
      "separateMajorMinor": true,
      "separateMinorPatch": true,
      // Expose intermediate minor versions; upgrades must still be completed in order.
      "separateMultipleMinor": true
    },
    {
      "description": "Keep kubectl, topf and tuppr Kubernetes targets together, with sequential minor upgrade PRs",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/siderolabs/kubelet"
      ],
      "versioning": "semver",
      "semanticCommitScope": "kubernetes",
      "commitMessageExtra": "( v{{{replace '^v' '' currentVersion}}} ➔ v{{{replace '^v' '' newVersion}}} )",
      "sourceUrl": "https://github.com/kubernetes/kubernetes",
      "automerge": false,
      "separateMajorMinor": true,
      "separateMinorPatch": true,
      // Offer the latest patch in each minor stream; merge and complete upgrades in order.
      "separateMultipleMinor": true,
      "prBodyNotes": [
        "Upgrade to the latest patch of the current Kubernetes minor first, then advance one minor at a time. Wait for tuppr to complete each upgrade before merging the next; these PRs do not enforce ordering. Keep .mise.toml kubectl, talos/topf.yaml and KubernetesUpgrade on the same target and check Talos compatibility before merging."
      ]
    },
    {
      "description": "Keep the Flux CLI and cluster target on the same release",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "fluxcd/flux2"
      ],
      "versioning": "semver",
      "semanticCommitScope": "flux",
      "commitMessageExtra": "( v{{{replace '^v' '' currentVersion}}} ➔ v{{{replace '^v' '' newVersion}}} )",
      "automerge": false,
      "prBodyNotes": [
        "Keep the Flux CLI in .mise.toml and the FluxInstance distribution version on the same target. Review the Flux release notes and Flux Operator compatibility before merging."
      ]
    },
    {
      "description": "Offer Cilium updates per minor stream for sequential upgrades",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "cilium"
      ],
      "separateMajorMinor": true,
      "separateMinorPatch": true,
      "separateMultipleMinor": true
    },
    {
      "description": "Let the Talos Factory manager update talosctl with the cluster target",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "talosctl"
      ],
      "enabled": false
    },
    {
      "description": "Let the Kubernetes target manager update kubectl with the cluster",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "kubectl"
      ],
      "enabled": false
    },
    {
      "description": "Let the Flux release manager update the CLI with the cluster target",
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "fluxcd/flux2"
      ],
      "enabled": false
    },
    {
      "description": "Offer PostgreSQL maintenance updates within the existing major only; major upgrades require a migration",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchFileNames": [
        "kubernetes/apps/db/cloudnative-pg/cluster/pg17-monolith.yaml"
      ],
      "allowedVersions": "/^17\\./",
      "changelogUrl": "https://www.postgresql.org/docs/release/{{newVersion}}/",
      "prBodyNotes": [
        "Review the [PostgreSQL release notes](https://www.postgresql.org/docs/release/) for all intervening 17.x releases, including their migration instructions."
      ],
      "automerge": false
    },
    {
      "description": "Keep the CoreDNS builder on upstream's Go minor series; allow patch and digest updates",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "containers/coredns/Dockerfile"
      ],
      "matchPackageNames": [
        "golang"
      ],
      // Match .go-version in the pinned CoreDNS source; revisit on source upgrades.
      "allowedVersions": "/^1\\.26\\./"
    },
    {
      "description": "Keep custom CoreDNS resolver image promotion manual",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/geekifier/coredns"
      ],
      "enabled": false
    },
    // Keep bare registry versions valid while recognizing prefixed GitHub release
    // tags for inline notes. changelogUrl alone only adds a link to the PR.
    {
      "description": "Use ExternalDNS chart release notes rather than application version tags",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "external-dns"
      ],
      "sourceUrl": "https://github.com/kubernetes-sigs/external-dns",
      "sourceDirectory": "charts/external-dns",
      "extractVersion": "^(?:external-dns-helm-chart-)?(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "changelogUrl": "https://github.com/kubernetes-sigs/external-dns/releases/tag/external-dns-helm-chart-{{newVersion}}",
      "prBodyNotes": [
        "The chart release notes link to the bundled ExternalDNS application release. Review its [application release notes](https://github.com/kubernetes-sigs/external-dns/releases) as well as chart changes; both DNS instances follow the chart appVersion."
      ]
    },
    {
      "description": "Link csi-driver-smb to its GitHub repo",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "csi-driver-smb"
      ],
      "sourceUrl": "https://github.com/kubernetes-csi/csi-driver-smb"
    },
    {
      "description": "Link prometheus-community OCI charts to the helm-charts repo",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/prometheus-community/charts/prometheus-snmp-exporter",
        "ghcr.io/prometheus-community/charts/prometheus-smartctl-exporter"
      ],
      "sourceUrl": "https://github.com/prometheus-community/helm-charts"
    },
    {
      "description": "Link VictoriaMetrics charts to the helm-charts repo",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/victoriametrics/helm-charts/victoria-metrics-k8s-stack"
      ],
      "sourceUrl": "https://github.com/VictoriaMetrics/helm-charts"
    },
    {
      "description": "Link dragonfly-operator chart to its GitHub repo",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator"
      ],
      "sourceUrl": "https://github.com/dragonflydb/dragonfly-operator"
    },
    {
      "description": "Link CoreDNS chart to the coredns/helm repo",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/coredns/charts/coredns"
      ],
      "sourceUrl": "https://github.com/coredns/helm",
      "extractVersion": "^(?:coredns-)?(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "changelogUrl": "https://github.com/coredns/helm/releases/tag/coredns-{{newVersion}}",
      "prBodyNotes": [
        "Review [CoreDNS application release notes](https://github.com/coredns/coredns/releases) when the chart appVersion changes. The custom resolver image is promoted separately."
      ]
    },
    {
      "description": "Link Reloader chart to its GitHub releases",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/stakater/charts/reloader"
      ],
      "sourceUrl": "https://github.com/stakater/Reloader",
      "extractVersion": "^(?:chart-v)?(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "changelogUrl": "https://github.com/stakater/Reloader/releases/tag/chart-v{{newVersion}}"
    },
    {
      "description": "Link Jellyfin image to the jellyfin/jellyfin repo",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/jellyfin/jellyfin"
      ],
      "sourceUrl": "https://github.com/jellyfin/jellyfin"
    },
    {
      "description": "Link mumble-server to its GitHub repo",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/mumble-voip/mumble-server"
      ],
      "sourceUrl": "https://github.com/mumble-voip/mumble"
    },
    {
      "description": "Hold mumble-server on 1.5.x until the 1.6 database backend is ready",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/mumble-voip/mumble-server"
      ],
      "allowedVersions": "/^v1\\.5\\./"
    }
  ],
  "customManagers": [
    {
      "description": "Keep mise Flux CLI on the same GitHub release as the cluster target",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.mise\\.toml$/"
      ],
      "matchStrings": [
        "\"aqua:fluxcd/flux2\" = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "fluxcd/flux2",
      "versioningTemplate": "semver",
      // GitHub releases have a leading v; mise's tool pin does not.
      "extractVersionTemplate": "^v?(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$"
    },
    {
      "description": "Keep mise talosctl on the same Talos Factory release as the cluster target",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.mise\\.toml$/"
      ],
      "matchStrings": [
        "talosctl = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "custom.talos-factory",
      "depNameTemplate": "siderolabs/talos",
      "versioningTemplate": "semver",
      // Factory tags have a leading v; mise's tool pin does not.
      "extractVersionTemplate": "^v?(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$"
    },
    {
      "description": "Keep mise kubectl on the same Kubernetes release as topf and tuppr",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.mise\\.toml$/"
      ],
      "matchStrings": [
        "kubectl = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/siderolabs/kubelet",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$"
    },
    {
      "description": "Track only the CNPG postgres17 cluster imageName field",
      "customType": "regex",
      "managerFilePatterns": [
        "/^kubernetes/apps/db/cloudnative-pg/cluster/pg17-monolith\\.yaml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)[ \\t]*imageName:[ \\t]*[\"\\x27]?(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>17\\.[0-9]+(?:\\.[0-9]+)?)(?:[\"\\x27]|[ \\t\\r\\n]|$)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "Process annotated scalar dependencies without capturing quotes or comments",
      "customType": "regex",
      "managerFilePatterns": [
        "/^containers/coredns/Dockerfile$/",
        "/(^|/).+\\.env(?:\\.j2)?$/",
        "/(^|/).+\\.sh(?:\\.j2)?$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: repository=(?<registryUrl>[^\\s]+))?[ \\t]*\\r?\\n[ \\t]*(?:(?:export|ARG|ENV)[ \\t]+)?[A-Za-z_][A-Za-z0-9_.-]*[ \\t]*(?::[ \\t]+|=[ \\t]*)(?:&[^\\s]+[ \\t]+)?[\"\\x27]?(?<currentValue>[^\\s\"\\x27#]+)"
      ],
      "datasourceTemplate": "{{{datasource}}}"
    },
    // Match the whole URL; Renovate globally replaces the bare version in the
    // release path and asset filename, preserving any v prefix in either place.
    {
      "description": "Update annotated GitHub release URLs, including matching versions in asset filenames",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/).+\\.sh(?:\\.j2)?$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: repository=(?<registryUrl>[^\\s]+))?[ \\t]*\\r?\\n[ \\t]*(?:#[ \\t]*)?https://(?:github\\.com/[^/\\s]+/[^/\\s]+/releases/download|raw\\.githubusercontent\\.com/[^/\\s]+/[^/\\s]+)/v?(?<currentValue>[0-9]+(?:\\.[0-9]+)+(?:[-+][0-9A-Za-z.-]+)?)/[^\\s\"\\x27#]+"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>[0-9]+(?:\\.[0-9]+)+(?:[-+][0-9A-Za-z.-]+)?)$"
    },
    {
      "customType": "regex",
      "description": "Process OCI dependencies",
      "managerFilePatterns": [
        "/\\.yaml(?:\\.j2)?$/"
      ],
      "matchStrings": [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
