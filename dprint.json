{
  "lineWidth": 100,
  "indentWidth": 4,
  "useTabs": false,
  "newLineKind": "lf",
  "json": {
    "array.preferSingleLine": false,
    "object.preferSingleLine": false,
    "indentWidth": 2
  },
  "markdown": {
    "textWrap": "maintain",
    "codeBlock.skipFormat": true
  },
  "yaml": {
    "printWidth": 100,
    "indentWidth": 2,
    "proseWrap": "preserve"
  },
  "excludes": [
    "**/*.sops.*",
    "**/*.{j2,jinja,jinja2,gotmpl,tmpl,tpl}",
    "**/node_modules"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.24.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
